# Ignore everything unless explicitly allowed below.
*

# Keep traversing directories so nested allowlisted files can be discovered.
!*/

# Repository metadata and documentation.
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md

# Go source and module metadata.
!*.go
!/go.mod
!/go.sum

# Trusted contracts shipped with vego, and those used by its tests.
!/vego/trusted/std/*.yaml
!/vego/testdata/*.yaml

# The recorded cost of verifying the corpus; see vego/guard_test.go.
!/vego/testdata/costs.txt

# Test packages that stand for other modules have a go.mod of their own,
# which the loader of the tests ignores and vego reads.
!/vego/testdata/src/*/go.mod
!/vego/testdata/src/*/vego-trusted.yaml

# Design notes and guides.
!/vego/ROADMAP.md
!/docs/*.md

# Agent skills.
!/skills/*/SKILL.md
!/.agents/skills/create-task/SKILL.md
!/skills-lock.json

# Go documentation eval tooling. Generated tasks, caches, jobs, and secrets stay ignored.
!/evals/golang-docs/README.md
!/evals/golang-docs/AGENTS.md
!/evals/golang-docs/manifest.json
!/evals/golang-docs/EXPERIMENT.md
!/evals/golang-docs/REFLECTION.md
!/evals/golang-docs/experiment.json
!/evals/golang-docs/experiment-sol.json
!/evals/golang-docs/results/*.json
/evals/golang-docs/tasks/
/evals/golang-docs/.cache/
/evals/golang-docs/.venv/
/evals/golang-docs/jobs/
/jobs/
.env
.env.*
!/evals/golang-docs/.env.example
